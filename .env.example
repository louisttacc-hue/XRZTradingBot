# ─────────────────────────────────────────────────────────────────────────────
#  EF-Untis-WhatsApp-Bot – Konfiguration
#  Kopieren nach .env (./install.sh macht das automatisch) und ausfüllen.
#  .env enthält Zugangsdaten: NIE committen, Rechte 600 (nur der Bot-Benutzer).
# ─────────────────────────────────────────────────────────────────────────────

# ── WebUntis ────────────────────────────────────────────────────────────────
# Server und Schulname findest du mit:  npm run find-school -- "Jüchen"
# (oder in der WebUntis-Adresse: https://SERVER/WebUntis/?school=SCHULE)
UNTIS_SERVER=nessa.webuntis.com
UNTIS_SCHOOL=gym-juechen

# Login-Art:
#   password  = Untis-Benutzername + Passwort
#   secret    = Schul-Login über Microsoft/IServ o. ä.: In WebUntis unter
#               Profil → Freigaben → "Zugriff über Untis Mobile" → Anzeigen
#               den QR-Code-Link (untis://setschool?...&key=...) in UNTIS_SECRET einfügen
#   anonymous = öffentlicher Zugang (nur wenn die Schule ihn freigeschaltet hat)
UNTIS_AUTH=password
UNTIS_USERNAME=
UNTIS_PASSWORD=
UNTIS_SECRET=

# Überwachte Klasse(n) – alle Kurse dieser Klasse werden getrackt.
# Mehrere mit Komma (z. B. EF,EFa). Leer = eigene Klasse des Untis-Accounts.
UNTIS_CLASSES=EF

# ── WhatsApp ────────────────────────────────────────────────────────────────
# true  = Bot läuft als verknüpftes Gerät auf DEINER Nummer (wie WhatsApp Web) – keine 2. SIM nötig.
#         Bot-Nachrichten beginnen mit 🤖, du kannst selbst Befehle schreiben (auch im Chat
#         "Nachricht an mich selbst"), Fehlermeldungen landen dort.
# false = separate Bot-Nummer (zweite SIM oder Festnetz-WhatsApp-Business)
WHATSAPP_OWN_NUMBER=true
# Kennzeichnung vor jeder Bot-Nachricht (Standard auf eigener Nummer: "🤖 ")
# BOT_MESSAGE_PREFIX="🤖 "
# Gruppe wird normalerweise bei "npm run setup" ausgewählt. Alternativ:
# Einladungslink der Klassengruppe – der Bot tritt einmalig selbst bei.
WHATSAPP_GROUP_INVITE=
# Feste Gruppen-ID (z. B. 120363012345678901@g.us), überschreibt alles andere.
WHATSAPP_GROUP_JID=
# Statt QR-Code per Kopplungscode verknüpfen: Nummer mit Ländervorwahl, z. B. 4915112345678
WHATSAPP_PAIRING_NUMBER=
# Befehle auch im Privatchat mit dem Bot beantworten (Standard: nur in der Gruppe)
ALLOW_PRIVATE_COMMANDS=false
# Admin-Nummer(n) für Fehlermeldungen per Privatnachricht, z. B. 4915112345678 (Komma-getrennt).
# Auf der eigenen Nummer leer lassen → Fehlermeldungen kommen in "Nachricht an mich selbst".
ADMIN_NUMBERS=

# ── Verhalten ───────────────────────────────────────────────────────────────
# Abfrageintervall in Minuten (min. 3). Nachts (0–5 Uhr) automatisch alle 30 Minuten.
POLL_INTERVAL_MINUTES=5
# Wie viele Tage im Voraus überwacht werden
LOOKAHEAD_DAYS=14
# Nachtruhe: Meldungen in diesem Zeitraum werden bis zum Ende gesammelt. Leer = aus.
QUIET_HOURS=22:00-06:00
# Ab so vielen Änderungen auf einmal kommt nur eine Zusammenfassung (Anti-Spam)
MAX_EVENTS_PER_MESSAGE=25
# Begrüßungsnachricht beim allerersten Start
SEND_WELCOME_MESSAGE=true
# Gleicher Befehl im selben Chat höchstens alle n Sekunden
COMMAND_COOLDOWN_SECONDS=30
# Anzeigename in Nachrichten (Standard: Klassenname)
BOT_CLASS_LABEL=EF
TIMEZONE=Europe/Berlin

# ── Technik ─────────────────────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=info
